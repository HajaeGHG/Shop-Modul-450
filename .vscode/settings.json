        {
            "name": "Shop Maven Tests",
            "workingDirectory": "${workspaceFolder}/shop",
            "vmArgs": [
                "-Dnet.bytebuddy.experimental=true"
            ]
        }
    ],
    "chat.extensionUnification.enabled": true
}